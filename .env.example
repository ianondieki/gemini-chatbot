# Get a Gemini key (FREE, no card): https://aistudio.google.com/  -> "Get API key"
# Get a Tavily key (free tier):     https://app.tavily.com/

GEMINI_API_KEY=your-gemini-key-here
TAVILY_API_KEY=tvly-your-key-here

# Optional — override the model. Default is gemini-2.5-flash.
# Other options: gemini-2.5-flash-lite (lighter), gemini-2.5-pro (stronger)
GEMINI_MODEL=gemini-2.5-flash
# ---------------------------------------------------------------------------
# Optional: how hard the agent works. The defaults are free-tier friendly.
# ---------------------------------------------------------------------------

# Extended thinking. -1 lets the model decide, 0 turns it off, or set a token cap.
# AGENT_THINKING_BUDGET=-1

# When to draft an explicit plan first: auto (default), always, never.
# AGENT_PLANNING=auto

# Limits per user turn.
# AGENT_MAX_STEPS=12
# AGENT_MAX_TOOL_CALLS=24
# AGENT_MAX_REFLECTIONS=2
# AGENT_WALL_CLOCK_SECONDS=180

# ---------------------------------------------------------------------------
# Optional: voice. Speech in and out run on the same Gemini key - no extra
# service and no extra dependency.
# ---------------------------------------------------------------------------

# Model used to transcribe speech. Blank uses GEMINI_MODEL.
# GEMINI_STT_MODEL=

# Text-to-speech model and voice (any Gemini prebuilt voice name).
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_VOICE=Kore

# ---------------------------------------------------------------------------
# Optional: the embedding cache, so re-uploading the same PDF is instant.
# ---------------------------------------------------------------------------
# RAG_CACHE=true
# RAG_CACHE_DIR=.rag_cache
